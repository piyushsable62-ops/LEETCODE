
class Solution {
    public boolean isPalindrome(ListNode head) {
        ArrayList<ListNode> arr = new ArrayList<>();
        if(head == null){
            return true;
        }
      ListNode temp = head;
        
        while(temp != null){
            arr.add(temp);
            temp = temp.next;
        }
        int i = 0;
        int j = arr.size()-1;
        while(i<j){
            if(arr.get(i).val != arr.get(j).val){
                return false;
            }
            i++;
            j--;
            }
            return true;
        }
        
    }
